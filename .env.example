# Optional. The app runs with these defaults if you skip creating .env.local.
# Copy to .env.local to override. Do not put secrets here — v1 has no API keys.

# Minimum delay between outbound requests to the same host, in milliseconds.
RATE_LIMIT_MS=1500

# Minimum delay between any outbound requests, in milliseconds.
GLOBAL_RATE_LIMIT_MS=400

# Per-request timeout when reading a brand page or Depop.
FETCH_TIMEOUT_MS=8000

# How long a successful public response is reused, in milliseconds.
CACHE_TTL_MS=600000

# Depop storefront prefix: us, uk, au, eu, de, fr, or it.
DEPOP_COUNTRY=us

# Maximum listing cards to show when a Depop search page is actually readable.
MAX_LISTINGS=12
